#!/bin/sh
# Slower checks once per push. Enable with: git config core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"
# What's being pushed: git gives "<local ref> <local sha> <remote ref>
# <remote sha>" per ref on stdin; kept for the mutation report (last).
pushed=$(cat)

# Tests: nextest when installed (every test in its own process, all
# binaries' tests in one pool: ~15 s here against cargo test's ~90 s),
# else cargo test. Nextest doesn't run doctests, so they get their own
# step (the workspace has none today; it costs ~1 s).
if cargo nextest --version >/dev/null 2>&1; then
  echo "pre-push: cargo nextest run"
  cargo nextest run --workspace --no-fail-fast --status-level fail --final-status-level slow
  echo "pre-push: cargo test --doc"
  cargo test --workspace --doc --quiet
else
  echo "pre-push: cargo test (cargo-nextest not installed: cargo install --locked cargo-nextest)"
  cargo test --workspace --quiet
fi

# Unused dependencies (cargo-machete: a text search of each crate for its
# dependencies' names, under a second). Skipped with a note if it isn't
# installed. A false positive is silenced in that crate's Cargo.toml
# ([package.metadata.cargo-machete] ignored = ["name"]).
if cargo machete --version >/dev/null 2>&1; then
  echo "pre-push: cargo machete (unused dependencies)"
  cargo machete
else
  echo "pre-push: cargo machete skipped (cargo install --locked cargo-machete)"
fi

# Site JS unit tests (pure modules only; node's built-in runner, no deps).
# A glob, not a directory: node --test treats a directory as a module path.
# Doc comments' intra-doc links ([`Item`]) must resolve: moving items
# between modules breaks them silently otherwise (found splitting
# scenarios.rs; three were already broken on main).
# Each library's public API against its snapshot in docs/api/ (xtask
# api.rs): a widened or changed surface must be recorded, so it shows in
# the PR's diff. Skips with a message without cargo-public-api or its
# pinned nightly. ~1 s.
echo "pre-push: cargo xtask api --check"
cargo xtask api --check

echo "pre-push: cargo doc (links checked)"
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --quiet

echo "pre-push: node --test (site JS)"
node --test 'tests/site/**/*.test.js'

# Every library crate must compile for wasm, not just `web` (xtask is a
# host-only CLI; test-support is test tooling whose proptest dependency
# needs OS randomness, which wasm32-unknown-unknown lacks). `check` skips codegen, so this is fast; the release .wasm
# is `cargo xtask site`'s job.
# The same math/engine tests as wasm (wasm32-wasip1 under wasmtime), so the
# golden hashes must match on wasm too: cross-platform determinism. ~1 s.
echo "pre-push: cargo xtask test-wasm"
cargo xtask test-wasm

echo "pre-push: cargo check (wasm32-unknown-unknown)"
cargo check --workspace --exclude xtask --exclude test-support --target wasm32-unknown-unknown --quiet

# Browser smoke test: headless Chrome loads the demo and checks it draws
# (needs python3 and Chrome; see README). ~2-3 s.
echo "pre-push: cargo xtask smoke"
cargo xtask smoke

# Mutation report: informational, never fails the push (everything above
# already passed), and opt-in (MUTANTS=1, below). Mutates only the lines
# this push changes and lists the mutants no test caught. Needs
# cargo-mutants; MUTANTS_MAX (default 60) caps how many run before it
# prints the command instead (docs/04-testing.md, "Mutation testing").

# The push's Rust diff into $1; empty if none.
push_diff() {
  zero=0000000000000000000000000000000000000000
  echo "$pushed" | while read -r _ local_sha _ remote_sha; do
    [ -n "${local_sha:-}" ] && [ "$local_sha" != "$zero" ] || continue
    if [ "$remote_sha" = "$zero" ]; then
      remote_sha=$(git merge-base origin/main "$local_sha" 2>/dev/null) || continue
    fi
    git diff "$remote_sha" "$local_sha" -- '*.rs'
  done > "$1"
}

mutation_count() {
  command -v cargo-mutants >/dev/null 2>&1 || return 0
  mkdir -p target
  push_diff target/pre-push.diff
  [ -s target/pre-push.diff ] || return 0
  count=$(cargo mutants --list --in-diff target/pre-push.diff 2>/dev/null | wc -l | tr -d ' ')
  [ "$count" -gt 0 ] || return 0
  echo "pre-push: mutants: $count in the changed lines, not run (MUTANTS=1 runs them; or:"
  echo "  cargo xtask mutants --in-diff target/pre-push.diff -o mutants.out/pre-push )"
}

mutation_report() {
  command -v cargo-mutants >/dev/null 2>&1 || { echo "pre-push: mutants: cargo-mutants not installed, skipped"; return; }
  zero=0000000000000000000000000000000000000000
  diff_file=$(mktemp)
  echo "$pushed" | while read -r _ local_sha _ remote_sha; do
    [ -n "${local_sha:-}" ] && [ "$local_sha" != "$zero" ] || continue
    # A new branch: its changes since it left origin/main.
    if [ "$remote_sha" = "$zero" ]; then
      remote_sha=$(git merge-base origin/main "$local_sha" 2>/dev/null) || continue
    fi
    git diff "$remote_sha" "$local_sha" -- '*.rs'
  done > "$diff_file"
  if [ ! -s "$diff_file" ]; then
    echo "pre-push: mutants: no Rust changes"
    rm -f "$diff_file"; return
  fi
  count=$(cargo mutants --list --in-diff "$diff_file" 2>/dev/null | wc -l | tr -d ' ')
  max=${MUTANTS_MAX:-60}
  if [ "$count" -eq 0 ]; then
    echo "pre-push: mutants: no mutable code changed"
  elif [ "$count" -gt "$max" ]; then
    cp "$diff_file" target/pre-push.diff
    echo "pre-push: mutants: $count mutants (over MUTANTS_MAX=$max), not run. To run them:"
    echo "  cargo xtask mutants --in-diff target/pre-push.diff -o mutants.out/pre-push"
  else
    echo "pre-push: mutants: $count in the changed lines (informational)"
    CARGO_PROFILE_TEST_OPT_LEVEL=1 cargo xtask mutants -j 4 --in-diff "$diff_file" \
      -o mutants.out/pre-push >/dev/null 2>&1 || true
    missed=mutants.out/pre-push/mutants.out/missed.txt
    if [ -s "$missed" ]; then
      echo "pre-push: mutants: $(wc -l < "$missed" | tr -d ' ') missed (no test noticed); worth a look:"
      sed 's/^/  /' "$missed"
    else
      echo "pre-push: mutants: every mutant in the changed lines was caught"
    fi
  fi
  rm -f "$diff_file"
}
# Opt in with MUTANTS=1: a run can take minutes, and git holds the
# connection to GitHub open (idle) for the whole hook, which GitHub drops
# (a stack push failed that way). Otherwise it reports the count and the
# command to run it.
if [ "${MUTANTS:-0}" = "1" ]; then
  mutation_report || true
else
  mutation_count || true
fi
