#!/bin/sh
# Fast checks on every commit. Enable with: git config core.hooksPath .githooks
# Bypass (emergencies only): git commit --no-verify
set -eu
cd "$(git rev-parse --show-toplevel)"

# Site source is TypeScript: type-check it (no emit). The compiler is
# pinned in package-lock.json; `npm ci` installs it.
echo "pre-commit: tsc --noEmit (site TypeScript)"
if [ ! -x node_modules/.bin/tsc ]; then
  echo "pre-commit: TypeScript not installed; run \`npm ci\` (see README)" >&2
  exit 1
fi
node_modules/.bin/tsc -p tsconfig.json --noEmit

# The JS unit tests (tests/site) are plain .js: syntax-check them. Piped
# with --input-type=module: `node --check file.js` silently passes
# ES-module syntax errors in .js files (Node 22).
echo "pre-commit: node --check (site unit tests)"
find tests/site -name '*.js' | while IFS= read -r f; do
  if ! node --input-type=module --check < "$f"; then
    echo "pre-commit: JS syntax error in $f" >&2
    exit 1
  fi
done

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy (warnings are errors)"
cargo clippy --workspace --all-targets --quiet -- -D warnings

# Code behind #[cfg(target_arch = "wasm32")] (the JS imports) is invisible
# to the native run above; lint the web crate as wasm too.
echo "pre-commit: cargo clippy web (wasm32)"
cargo clippy -p web --target wasm32-unknown-unknown --quiet -- -D warnings
