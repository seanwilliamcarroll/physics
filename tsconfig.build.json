{
  // Emits site/js/*.js (+ source maps, so DevTools shows the .ts) next to
  // the .ts sources. The library only: with allowJs on, emitting would try
  // to overwrite the demos' own .js. Run by `cargo xtask site`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": false,
    "noEmitOnError": true,
    "sourceMap": true,
    // Embed the .ts text in each .map: static servers send .ts as
    // video/mp2t (MPEG transport stream), so DevTools shouldn't have to
    // fetch it.
    "inlineSources": true
  },
  "include": ["site/js/**/*.ts"]
}
