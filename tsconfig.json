{
  // Type-checks site/: the TypeScript library (site/js/*.ts) and the demos'
  // plain .js (JSDoc). Checks only; tsconfig.build.json emits.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Only TS syntax that compiles by deletion (no enums, namespaces, or
    // parameter properties), so emitted .js mirrors the source and Node can
    // run the .ts directly in tests.
    "erasableSyntaxOnly": true,
    // Library files import "./ring.ts" (what Node needs); emit rewrites
    // those to "./ring.js" for the browser.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["site/js/**/*.ts", "site/demos/**/*.js"]
}
