{
  // Type-checks site/'s plain .js (JSDoc annotations) without emitting
  // anything: browsers run the .js files exactly as written.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Native ES modules with explicit ".js" import paths, as the browser
    // loads them.
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["site/**/*.js", "site/**/*.d.ts"],
  "exclude": ["site/pkg"]
}
