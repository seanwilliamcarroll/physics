{
  // All of site/ is TypeScript: the library (site/js/*.ts) and the demo
  // pages (site/demos/*/main.ts). `tsc` emits .js + source maps next to
  // each .ts (gitignored); `tsc --noEmit` only checks (pre-commit).
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Only TS syntax that compiles by deletion (no enums, namespaces, or
    // parameter properties), so emitted .js mirrors the source and Node can
    // run the .ts directly in tests.
    "erasableSyntaxOnly": true,
    // Source imports "./ring.ts" (what Node needs); emit rewrites those to
    // "./ring.js" for the browser.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "sourceMap": true,
    // Embed the .ts text in each .map: static servers send .ts as
    // video/mp2t (MPEG transport stream), so DevTools shouldn't have to
    // fetch it.
    "inlineSources": true
  },
  "include": ["site/**/*.ts"],
  "exclude": ["site/pkg"]
}
