+/// Body i, as the sweep needs it: its position and `G m_i`.
+#[derive(Clone, Copy)]
+struct Body<S> {
+    x: S,
+    y: S,
+    gm: S,
+}
+
+/// What's left of the arrays: body i and the bodies after it.
+struct Rest<'a, S> {
+    x: &'a [S],
+    y: &'a [S],
+    m: &'a [S],
+    w: &'a [S],
+    ax: &'a mut [S],
+    ay: &'a mut [S],
+}
+
+/// The first body of a [`Rest`]: its values, and its acceleration to add to.
+struct First<'a, S> {
+    x: S,
+    y: S,
+    m: S,
+    w: S,
+    ax: &'a mut S,
+    ay: &'a mut S,
+}
+
+impl<'a, S: Copy> Rest<'a, S> {
+    /// The first body, and the rest after it; `None` when empty.
+    fn split_first(self) -> Option<(First<'a, S>, Self)> {
+        let ((&x, x_rest), (&y, y_rest)) = (self.x.split_first()?, self.y.split_first()?);
+        let ((&m, m_rest), (&w, w_rest)) = (self.m.split_first()?, self.w.split_first()?);
+        let ((ax, ax_rest), (ay, ay_rest)) =
+            (self.ax.split_first_mut()?, self.ay.split_first_mut()?);
+        Some((
+            First { x, y, m, w, ax, ay },
+            Self {
+                x: x_rest,
+                y: y_rest,
+                m: m_rest,
+                w: w_rest,
+                ax: ax_rest,
+                ay: ay_rest,
+            },
+        ))
+    }
+}
+
+/// Lane by lane: `[f(a0, b0), .., f(a3, b3)]`, written out (no loop).
+fn map2<S: Copy>(
+    [a0, a1, a2, a3]: [S; LANES],
+    [b0, b1, b2, b3]: [S; LANES],
+    f: impl Fn(S, S) -> S,
+) -> [S; LANES] {
+    [f(a0, b0), f(a1, b1), f(a2, b2), f(a3, b3)]
+}
+
+/// `(l0 + l1) + (l2 + l3)`.
+fn lane_total<S: Scalar>([l0, l1, l2, l3]: [S; LANES]) -> S {
+    (l0 + l1) + (l2 + l3)
+}
+
+/// Body `i` against every later body: each pair's force, added to body j's
+/// acceleration (`ax`, `ay`, times `w_j`) and to body i's lanes (returned,
+/// to be multiplied by `w_i`). In blocks of LANES pairs, every array
+/// separate and every lane the same straight-line arithmetic, so the
+/// compiler packs a block into vector instructions; the slices are
+/// parameters, so it knows they don't overlap.
+#[inline(never)]
+#[expect(
+    clippy::too_many_arguments,
+    reason = "one slice per array, so they're noalias"
+)]
+fn sweep<S: Scalar>(
+    i: Body<S>,
+    eps_sq: S,
+    xs: &[S],
+    ys: &[S],
+    ms: &[S],
+    ws: &[S],
+    ax: &mut [S],
+    ay: &mut [S],
+) -> ([S; LANES], [S; LANES]) {
+    let (mut lx, mut ly) = ([S::ZERO; LANES], [S::ZERO; LANES]);
+    let (xb, x_rest) = xs.as_chunks::<LANES>();
+    let (yb, y_rest) = ys.as_chunks::<LANES>();
+    let (mb, m_rest) = ms.as_chunks::<LANES>();
+    let (wb, w_rest) = ws.as_chunks::<LANES>();
+    let (axb, ax_rest) = ax.as_chunks_mut::<LANES>();
+    let (ayb, ay_rest) = ay.as_chunks_mut::<LANES>();
+    let blocks = xb
+        .iter()
+        .zip(yb)
+        .zip(mb)
+        .zip(wb)
+        .zip(axb.iter_mut().zip(ayb.iter_mut()));
+    for ((((x4, y4), m4), w4), (ax4, ay4)) in blocks {
+        // Whole-block steps, no loop inside: each line is one vector op.
+        let rx = x4.map(|x| x - i.x);
+        let ry = y4.map(|y| y - i.y);
+        let d_sq = map2(rx, ry, |rx, ry| rx * rx + ry * ry + eps_sq);
+        let s = map2(d_sq, *m4, |d_sq, m| {
+            let s = i.gm * m / (d_sq * d_sq.sqrt());
+            if d_sq == S::ZERO { S::ZERO } else { s }
+        });
+        let fx = map2(rx, s, |r, s| r * s);
+        let fy = map2(ry, s, |r, s| r * s);
+        *ax4 = map2(*ax4, map2(fx, *w4, |f, w| f * w), |a, f| a - f);
+        *ay4 = map2(*ay4, map2(fy, *w4, |f, w| f * w), |a, f| a - f);
+        lx = map2(lx, fx, |l, f| l + f);
+        ly = map2(ly, fy, |l, f| l + f);
+    }
+    // The last few, into the same lanes in the same order.
+    let lanes = lx.iter_mut().zip(ly.iter_mut());
+    let tail = x_rest
+        .iter()
+        .zip(y_rest)
+        .zip(m_rest)
+        .zip(w_rest)
+        .zip(ax_rest.iter_mut().zip(ay_rest.iter_mut()));
+    for ((lx_k, ly_k), ((((&x, &y), &m), &w), (ax_j, ay_j))) in lanes.zip(tail) {
+        pair(i, eps_sq, (x, y, m, w), (ax_j, ay_j), (lx_k, ly_k));
+    }
+    (lx, ly)
+}
+
+/// One pair: body j's share subtracted from its acceleration, body i's
+/// added to its lane.
+fn pair<S: Scalar>(
+    i: Body<S>,
+    eps_sq: S,
+    (x, y, m, w): (S, S, S, S),
+    (ax_j, ay_j): (&mut S, &mut S),
+    (lx, ly): (&mut S, &mut S),
+) {
+    let (rx, ry) = (x - i.x, y - i.y);
+    let d_sq = rx * rx + ry * ry + eps_sq;
+    let s = i.gm * m / (d_sq * d_sq.sqrt());
+    // Coincident and unsoftened: 0/0, selected away (no branch).
+    let s = if d_sq == S::ZERO { S::ZERO } else { s };
+    let (fx, fy) = (rx * s, ry * s);
+    *ax_j -= fx * w;
+    *ay_j -= fy * w;
+    *lx += fx;
+    *ly += fy;
+}
